<?xml version="1.0" encoding="UTF-8"?>
<!--
  The syn launcher: Maven resolves syn and its plugins from Maven Central into .syn-cache, and `syn` (copied from syn.tmpl) runs it.
  Nothing here is built into your product. Edit the plugin list below to add your own commands; see README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>example</groupId>
    <artifactId>syn-launcher</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>syn launcher</name>

    <properties>
        <!-- One version for the head and the kit: they are released together. -->
        <syn.version>0.0.4</syn.version>
        <!-- Where the head's jars (lib) and the plugins (plugins/NAME/current/libs) are laid out; the syn script sets it. -->
        <syn.home>${project.basedir}/.syn-cache</syn.home>
    </properties>

    <dependencies>
        <!-- The head: loads plugins, enforces tiers, runs commands. -->
        <dependency>
            <groupId>com.loudsight</groupId>
            <artifactId>syn-cli</artifactId>
            <version>${syn.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>syn-head</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${syn.home}/lib</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- The generic commands. Each plugin is one execution like this one, laid out as plugins/NAME/current/libs. -->
                    <execution>
                        <id>syn-plugin-kit</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.loudsight</groupId>
                                    <artifactId>syn-plugin-kit</artifactId>
                                    <version>${syn.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${syn.home}/plugins/syn-plugin-kit/current/libs</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Your own commands, for example:
                    <execution>
                        <id>my-commands</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.example</groupId>
                                    <artifactId>my-commands</artifactId>
                                    <version>1.0.0</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${syn.home}/plugins/my-commands/current/libs</outputDirectory>
                        </configuration>
                    </execution>
                    -->
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Analysis gates (pmd, spotbugs, forbiddenapis), same versions and configuration as the parent pom. Not part of the default build. -->
        <profile>
            <id>analysis-only</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.10.3.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.github.spotbugs</groupId>
                                <artifactId>spotbugs</artifactId>
                                <version>4.10.3</version>
                            </dependency>
                            <dependency>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>1.14.0</version>
                            </dependency>
                            <dependency>
                                <groupId>com.loudsight</groupId>
                                <artifactId>build-tools</artifactId>
                                <version>0.1.2</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <failOnError>true</failOnError>
                            <maxAllowedViolations>0</maxAllowedViolations>
                            <includeTests>true</includeTests>
                            <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.14.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>de.thetaphi</groupId>
                        <artifactId>forbiddenapis</artifactId>
                        <version>3.9</version>
                        <configuration>
                            <!-- Bundled signatures stop at JDK 24; see the parent pom. -->
                            <targetVersion>24</targetVersion>
                            <bundledSignatures>
                                <bundledSignature>jdk-unsafe</bundledSignature>
                                <bundledSignature>jdk-deprecated</bundledSignature>
                                <bundledSignature>jdk-internal</bundledSignature>
                            </bundledSignatures>
                            <signatures>
                                <![CDATA[
@defaultMessage Use ZonedDateTime.now(ZoneOffset.UTC) or TimeProvider.DEFAULT.now() instead
java.time.LocalDateTime#now()
java.time.LocalDate#now()
java.time.LocalTime#now()
java.time.ZonedDateTime#now()
java.time.OffsetDateTime#now()
java.time.Instant#now()

@defaultMessage Use ZoneOffset.UTC explicitly
java.time.ZoneId#systemDefault()

@defaultMessage Use Locale.ROOT or Locale.US explicitly
java.lang.String#toLowerCase()
java.lang.String#toUpperCase()
java.lang.String#format(java.lang.String,java.lang.Object[])

@defaultMessage Use StandardCharsets.UTF_8 explicitly
java.lang.String#<init>(byte[])
java.lang.String#<init>(byte[],int,int)
java.lang.String#getBytes()
java.io.FileReader#<init>(java.lang.String)
java.io.FileReader#<init>(java.io.File)
java.io.FileWriter#<init>(java.lang.String)
java.io.FileWriter#<init>(java.io.File)
java.io.InputStreamReader#<init>(java.io.InputStream)
java.io.OutputStreamWriter#<init>(java.io.OutputStream)
                                ]]>
                            </signatures>
                            <failOnViolation>true</failOnViolation>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
