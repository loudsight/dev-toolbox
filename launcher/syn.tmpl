#!/bin/sh
#
# The syn launcher: copy this file next to pom.xml as `syn` and make it executable. The first run asks Maven to lay syn out in
# .syn-cache (delete that directory to update or to pick up a new plugin). Maven only warns on a bad checksum by default; this
# fails the download instead. SYN_MAVEN_ARGS adds Maven arguments, e.g. -o.
dir=$(cd "$(dirname "$0")" && pwd)
cache=$dir/.syn-cache
if [ ! -d "$cache/lib" ]; then
    echo "syn: setting up $cache" >&2
    # shellcheck disable=SC2086
    mvn -q --strict-checksums -f "$dir/pom.xml" package -Dsyn.home="$cache" $SYN_MAVEN_ARGS >&2 || exit 1
fi
REPO_ROOT=${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
export REPO_ROOT
# git bash converts a POSIX-looking argument to a Windows path for java.exe, except one that contains a wildcard, so the classpath
# below would reach java as /c/... and match no jar. Give java the drive-letter form there (MSYS_NO_PATHCONV does not help).
case $(uname -s) in
    MINGW*|MSYS*|CYGWIN*) classpath="$(cygpath -m "$cache")/lib/*" ;;
    *) classpath="$cache/lib/*" ;;
esac
exec java -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dsyn.plugins.dir="$cache/plugins" -cp "$classpath" com.loudsight.syn.cli.Syn "$@"
