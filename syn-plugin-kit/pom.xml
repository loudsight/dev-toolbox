<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.loudsight</groupId>
        <artifactId>dev-toolbox</artifactId>
        <version>0.0.2-SNAPSHOT</version>
    </parent>

    <version>0.0.2-SNAPSHOT</version>

    <artifactId>syn-plugin-kit</artifactId>
    <name>Loudsight syn plugin kit</name>
    <description>
        The generic syn commands: the ones that keep a repository in order and do not depend on any one
        repository's layout. A syn plugin like any other: built with -Dsyn.plugins.dir=DIR it lays itself out
        as DIR/syn-plugin-kit/current/libs, where the head loads it from.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <enforcer.skip>true</enforcer.skip>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- The head supplies these; provided keeps them out of the plugin's libs. -->
        <dependency>
            <groupId>com.loudsight</groupId>
            <artifactId>syn-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.loudsight</groupId>
            <artifactId>syn-core</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <!-- With -Dsyn.plugins.dir=DIR: lay the plugin out the way the head loads it, the jar and its
                 runtime dependencies together in DIR/{artifactId}/current/libs. -->
            <id>syn-install</id>
            <activation>
                <property>
                    <name>syn.plugins.dir</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>syn-plugin-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${syn.plugins.dir}/${project.artifactId}/current/libs</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>syn-plugin-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${syn.plugins.dir}/${project.artifactId}/current/libs</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
